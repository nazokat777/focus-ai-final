{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "www",
  "headers": [
    {
      "comment": "APK (bundled) ichidagi Service Worker saytdan eng oxirgi kodni o'qishi uchun CORS",
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/focusai.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"FocusAI.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
