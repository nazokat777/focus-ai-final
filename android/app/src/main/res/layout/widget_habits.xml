<?xml version="1.0" encoding="utf-8"?>
<!-- Odatlar widgeti: chapda odat nomlari, o'ngda 7 kunlik nuqta jadvali -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wh_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_card"
    android:padding="14dp">

    <!-- Sarlavha qatori: brend + hafta kunlari harflari -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FOCUS AI"
            android:textColor="@color/w_neon"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/wh_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/wh_d0" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/w_muted" android:textSize="9sp" android:text="D" />
            <TextView android:id="@+id/wh_d1" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/w_muted" android:textSize="9sp" android:text="S" />
            <TextView android:id="@+id/wh_d2" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/w_muted" android:textSize="9sp" android:text="C" />
            <TextView android:id="@+id/wh_d3" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/w_muted" android:textSize="9sp" android:text="P" />
            <TextView android:id="@+id/wh_d4" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/w_muted" android:textSize="9sp" android:text="J" />
            <TextView android:id="@+id/wh_d5" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/w_muted" android:textSize="9sp" android:text="S" />
            <TextView android:id="@+id/wh_d6" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/w_neon" android:textSize="9sp" android:textStyle="bold" android:text="Y" />
        </LinearLayout>
    </LinearLayout>

    <!-- Odat qatorlari shu yerga kodda qo'shiladi -->
    <LinearLayout
        android:id="@+id/wh_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/wh_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="18dp"
        android:text="Odat qo\'shing"
        android:textColor="@color/w_muted"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
