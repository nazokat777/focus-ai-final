<?xml version="1.0" encoding="utf-8"?>
<!-- Progress widgeti: chapda halqa (bitmap), o'ngda bugungi odat qatorlari -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/w_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="14dp"
        android:paddingRight="14dp">

        <ImageView
            android:id="@+id/wp_ring"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@null" />

        <!-- Ilovadagi .pr-lbl uslubi: kichik, katta harf, keng oraliq -->
        <TextView
            android:id="@+id/wp_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="BUGUN"
            android:textColor="@color/w_muted"
            android:textSize="8.5sp"
            android:textAllCaps="true"
            android:letterSpacing="0.2"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wp_rows"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" />

</LinearLayout>
