<?xml version="1.0" encoding="utf-8"?>
<!-- Bitta odat qatori: belgi + nom + 7 kunlik nuqta -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Odat belgisi — ilovadagi rangli yumaloq-kvadrat ikonka kabi -->
    <ImageView
        android:id="@+id/wr_ic"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:scaleType="fitXY"
        android:src="@drawable/w_chip"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/wr_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/w_text"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView android:id="@+id/wr_0" android:layout_width="18dp" android:layout_height="12dp" android:scaleType="center" android:src="@drawable/w_dot" android:contentDescription="@null" />
        <ImageView android:id="@+id/wr_1" android:layout_width="18dp" android:layout_height="12dp" android:scaleType="center" android:src="@drawable/w_dot" android:contentDescription="@null" />
        <ImageView android:id="@+id/wr_2" android:layout_width="18dp" android:layout_height="12dp" android:scaleType="center" android:src="@drawable/w_dot" android:contentDescription="@null" />
        <ImageView android:id="@+id/wr_3" android:layout_width="18dp" android:layout_height="12dp" android:scaleType="center" android:src="@drawable/w_dot" android:contentDescription="@null" />
        <ImageView android:id="@+id/wr_4" android:layout_width="18dp" android:layout_height="12dp" android:scaleType="center" android:src="@drawable/w_dot" android:contentDescription="@null" />
        <ImageView android:id="@+id/wr_5" android:layout_width="18dp" android:layout_height="12dp" android:scaleType="center" android:src="@drawable/w_dot" android:contentDescription="@null" />
        <ImageView android:id="@+id/wr_6" android:layout_width="18dp" android:layout_height="12dp" android:scaleType="center" android:src="@drawable/w_dot" android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
